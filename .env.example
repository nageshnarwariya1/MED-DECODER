# Google AI Studio API key. Keep this on the server; never put it in public/app.js.
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Admin login (there is NO public-user login).
ADMIN_EMAIL=admin@meddecoder.in
ADMIN_PASSWORD=
SESSION_SECRET=

# Local development uses ./data. Render persistent disk uses /var/data.
DATA_DIR=./data
REPORT_RETENTION_DAYS=30
PORT=3000
NODE_ENV=development
